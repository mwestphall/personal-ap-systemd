#!/bin/bash
#SBATCH --job-name=htc-annex
#SBATCH --partition=<part>       # Partition to which you have job access
#SBATCH --time=4:00:00           # wall time, HH:MM:SS. Adjust based on your jobs' expected runtime.
#SBATCH --cpus-per-task=2        # CPUs for EP. Adjust based on your jobs' resource requirements.
#SBATCH --mem=4G                 # 
#SBATCH --output=annex-ep.debug
#SBATCH --error=annex-ep.debug

# sbatch copies this script into Slurm's spool dir before running it, so
# SLURM_SUBMIT_DIR (the directory sbatch was invoked from) is used to find
# sibling repo files, falling back to BASH_SOURCE for direct invocation.
SCRIPT_DIR="${SLURM_SUBMIT_DIR:-$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)}"

SOURCE="${1:?Usage: sbatch annex-ep.sub <path-to-annex-tarball> <ap-local-condor-dir>}"   # full path to the tarball from `htcondor annex create`
AP_DIR="${2:?Usage: sbatch annex-ep.sub <path-to-annex-tarball> <ap-local-condor-dir>}"   # the AP's condor install dir (contains local/, condor.sh, etc.)

if [ ! -f "$SOURCE" ]; then
  echo "ERROR: Specified source tarball $SOURCE does not exist"
  exit 1
fi

echo "Unpacking $SOURCE"
tar -xvf "$SOURCE" --strip-components=1

echo ""
echo "Displaying working directory"
ls -alh

echo ""
echo "Executing annex setup script"
bash annex-setup.sh

echo ""
echo "Minting a properly-scoped annex token from the AP's signing key"
# condor_token_fetch (used by `htcondor annex create` to mint annex.token)
# authenticates its request using whatever IDToken is already reachable on
# the shared filesystem, and a token can't be used to mint one with broader
# scope than itself - so the bundled annex.token silently ends up as
# READ/WRITE-only, matching install.sh's login-node testing token, rather
# than the READ/WRITE/ADVERTISE_STARTD/ADVERTISE_MASTER/DAEMON it actually
# needs. Mint our own replacement offline instead, using the AP's own
# signing key directly - no request/approval round-trip involved.
#
# Use ANNEX_TOKEN_DOMAIN (pinned by install.sh to a stable, install-specific
# value) rather than UID_DOMAIN: the HPC_ANNEX job transform matches
# submitted jobs against "$(MY.Owner)@$(ANNEX_TOKEN_DOMAIN)" evaluated fresh
# at submit time, so baking in UID_DOMAIN (hostname-derived, and different
# every time the AP resumes on a new node) would stop matching as soon as
# the AP moved.
(
    # shellcheck disable=SC1091
    . "$AP_DIR/condor.sh"
    IDENTITY="$(whoami)@$(condor_config_val ANNEX_TOKEN_DOMAIN)"
    condor_token_create -key AP -identity "$IDENTITY" \
        -authz READ -authz WRITE -authz ADVERTISE_STARTD -authz ADVERTISE_MASTER -authz DAEMON
) > annex.token

if [ ! -s annex.token ]; then
  echo "ERROR: Failed to mint a properly-scoped annex token"
  exit 1
fi

echo ""
echo "Configuring dynamic collector and schedd-name lookup"
# AP_SCHEDD_ADDRESS_FILE is just a convenience macro for passing this path to
# the cron job below - it is NOT the real SCHEDD_ADDRESS_FILE knob, and
# setting that one wouldn't help here: STARTD_DIRECT_ATTACH_SCHEDD_POOL being
# set forces the STARTD's direct-attach lookup through a collector query by
# name rather than a local address-file read (see update-annex-collector.sh
# for the full explanation), so ANNEX_PILOT_COLLECTOR and
# ANNEX_PILOT_SCHEDD_NAME both need to be kept in sync dynamically instead.
cat >> 20-annex-pilot-instance <<EOF

AP_SCHEDD_ADDRESS_FILE = ${AP_DIR}/local/spool/.schedd_address

STARTD_CRON_JOBLIST = \$(STARTD_CRON_JOBLIST) UPDATE_ANNEX_COLLECTOR
STARTD_CRON_UPDATE_ANNEX_COLLECTOR_EXECUTABLE = ${SCRIPT_DIR}/update-annex-collector.sh
STARTD_CRON_UPDATE_ANNEX_COLLECTOR_ARGS = \$(AP_SCHEDD_ADDRESS_FILE)
STARTD_CRON_UPDATE_ANNEX_COLLECTOR_MODE = Periodic
STARTD_CRON_UPDATE_ANNEX_COLLECTOR_PERIOD = 60
STARTD_CRON_LOG_NON_ZERO_EXIT = True
EOF

echo ""
echo "Executing HTC annex slurm script"
export SLURM_EXPORT_ENV=ALL
bash hpc.slurm > annex-job.out 2> annex-job.err
status=$?
echo "hpc.slurm exited with status ${status}"
exit "${status}"
