#!/bin/bash
#SBATCH --job-name=personal-ap
#SBATCH --partition=<part>       # Partition to which you have job access
#SBATCH --time=4:00:00           # wall time, HH:MM:SS. The AP runs only as long as this job does.
#SBATCH --cpus-per-task=1        # Adjust based on expected AP load.
#SBATCH --mem=2G                 # Adjust based on expected AP load.
#SBATCH --output=personal-ap.debug
#SBATCH --error=personal-ap.debug

REPO_DIR="${SLURM_SUBMIT_DIR:-$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)}"
INSTALL_SH="$REPO_DIR/install.sh"
START_SH="$REPO_DIR/start.sh"
TARBALL="${1:?Usage: sbatch ap.sub <path-to-condor-tarball> [base-dir]}"
BASE_DIR="${2:-}"                                   # defaults to install.sh's own default (/scratch/$USER) if omitted

if [ ! -x "$INSTALL_SH" ]; then
  echo "ERROR: $INSTALL_SH not found or not executable"
  exit 1
fi

if [ ! -x "$START_SH" ]; then
  echo "ERROR: $START_SH not found or not executable"
  exit 1
fi

if [ ! -f "$TARBALL" ]; then
  echo "ERROR: Specified HTCondor tarball $TARBALL does not exist"
  exit 1
fi

INSTALL_ARGS=(--tarball-path "$TARBALL")
if [ -n "$BASE_DIR" ]; then
  INSTALL_ARGS=(--base-dir "$BASE_DIR" --tarball-path "$TARBALL")
fi

if ! INSTALL_OUTPUT="$("$INSTALL_SH" "${INSTALL_ARGS[@]}")"; then
  echo "$INSTALL_OUTPUT"
  echo "ERROR: install.sh failed"
  exit 1
fi
echo "$INSTALL_OUTPUT"

CONDOR_DIR="$(echo "$INSTALL_OUTPUT" | sed -n 's/^CONDOR_DIR=//p' | tail -1)"
if [ -z "$CONDOR_DIR" ]; then
  echo "ERROR: install.sh did not report a CONDOR_DIR"
  exit 1
fi

exec "$START_SH" --condor-dir "$CONDOR_DIR"
