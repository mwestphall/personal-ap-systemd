#!/bin/bash
#
# Rendered by Open OnDemand from ood/personal_ap/template/script.sh.erb. Thin
# wrapper around install.sh and start.sh, copied alongside this script into
# ood/personal_ap/template/ (and staged alongside it at job runtime) so this
# app is self-contained; see ood-plan.md and the repo README's "Launch an AP
# via Open OnDemand" section.

set -euo pipefail

AP_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

WORKING_DIR="<%= working_dir %>"
TARBALL_PATH="<%= tarball_path %>"
BASE_DIR="<%= base_dir %>"

if [ -n "$WORKING_DIR" ]; then
    echo "==> Resuming existing AP at $WORKING_DIR"
    if [ ! -d "$WORKING_DIR" ]; then
        echo "error: working directory not found at $WORKING_DIR" >&2
        exit 1
    fi
    CONDOR_DIR="$WORKING_DIR"
else
    echo "==> Installing a fresh AP"
    if [ -z "$TARBALL_PATH" ]; then
        echo "error: tarball path is required when working directory is blank" >&2
        exit 1
    fi

    INSTALL_ARGS=(--tarball-path "$TARBALL_PATH")
    if [ -n "$BASE_DIR" ]; then
        INSTALL_ARGS=(--base-dir "$BASE_DIR" --tarball-path "$TARBALL_PATH")
    fi

    if ! INSTALL_OUTPUT="$("$AP_DIR/install.sh" "${INSTALL_ARGS[@]}")"; then
        echo "$INSTALL_OUTPUT"
        echo "error: install.sh failed" >&2
        exit 1
    fi
    echo "$INSTALL_OUTPUT"

    CONDOR_DIR="$(echo "$INSTALL_OUTPUT" | sed -n 's/^CONDOR_DIR=//p' | tail -1)"
    if [ -z "$CONDOR_DIR" ]; then
        echo "error: install.sh did not report a CONDOR_DIR" >&2
        exit 1
    fi
fi

exec "$AP_DIR/start.sh" --condor-dir "$CONDOR_DIR"
