#!/bin/bash
#
# Rendered by Open OnDemand from ood/personal_ap/template/script.sh.erb. Thin
# wrapper around install.sh and start.sh, copied alongside this script into
# ood/personal_ap/template/ (and staged alongside it at job runtime) so this
# app is self-contained; see ood-plan.md and the repo README's "Launch an AP
# via Open OnDemand" section.

set -euo pipefail

AP_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

BASE_DIR="<%= context.base_dir %>"
BASE_DIR="${BASE_DIR:-/scratch/$USER}" # must match install.sh's default base dir
CURRENT_AP="$BASE_DIR/current-ap"

if [ -d "$CURRENT_AP" ]; then
    echo "==> Resuming existing AP at $CURRENT_AP"
    exec "$AP_DIR/start.sh" --condor-dir "$CURRENT_AP"
fi

echo "==> Installing a fresh AP"
if ! INSTALL_OUTPUT="$("$AP_DIR/install.sh" --base-dir "$BASE_DIR")"; then
    echo "$INSTALL_OUTPUT"
    echo "error: install.sh failed" >&2
    exit 1
fi
echo "$INSTALL_OUTPUT"

exec "$AP_DIR/start.sh" --condor-dir "$CURRENT_AP"
