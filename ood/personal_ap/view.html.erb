<p>
  Your AP is running. To interact with it, open a shell on the login node and run:
</p>
<pre>. ~/.cache/current-ap/condor.sh</pre>
<%
  info = begin
    JSON.parse(File.read(File.join(Dir.home, ".cache", "current-ap", "ood-view.json")))
  rescue StandardError
    nil
  end
%>
<% if info %>
<p>
  <%= info["num_eps"] %> EP(s) currently attached to this AP
  <small>(as of <%= info["updated"] %>)</small>
</p>
<% end %>
<a class="btn btn-primary" href="/pun/sys/shell/ssh/default" target="_blank">
  Open login node shell
</a>
