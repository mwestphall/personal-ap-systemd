<%
  info = begin
    JSON.parse(File.read(File.join(Dir.home, ".cache", "current-ap", "ood-view.json")))
  rescue StandardError
    nil
  end
%>
<% if info.nil? %>
<p>Waiting for the AP to report its status&hellip;</p>
<% else %>
<p><small>Last updated: <%= info["updated"] %></small></p>
<p>Connected EPs: <strong><%= info["num_eps"] %></strong></p>
<p>
  Jobs in this AP:
  <strong><%= info["running"] %></strong> running,
  <strong><%= info["held"] %></strong> held,
  <strong><%= info["idle"] %></strong> idle
</p>

<% if info["num_eps"].to_i.zero? %>
<p>
  No EPs are connected to this AP yet, so no jobs can run. Launch an EP job to provide
  compute capacity: start <strong>Personal HTCondor EP</strong> from the Interactive Apps
  menu.
</p>
<a class="btn btn-primary" href="/pun/sys/dashboard/batch_connect/sessions" target="_blank">
  View my interactive sessions
</a>
<% else %>
<p>To interact with this AP, open a shell on the login node and run:</p>
<pre>. ~/.cache/current-ap/condor.sh</pre>
<p>
  New to HTCondor? See the
  <a href="https://htcondor.readthedocs.io/en/latest/users-manual/quick-start-guide.html" target="_blank">quick start guide</a>.
</p>
<a class="btn btn-primary" href="/pun/sys/shell/ssh/default" target="_blank">
  Open login node shell
</a>
<% end %>
<% end %>
